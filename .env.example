# Carregue com: uvicorn app:app --env-file .env --host 0.0.0.0 --workers 1
# Nos comandos python3, exporte as mesmas variáveis no shell.
# Caminhos relativos de DATABASE_PATH são resolvidos a partir da pasta do backend.
DATABASE_PATH=./vguard.db
PHOTOS_DIR=./fotos
DASHBOARD_DIR=../dashboard
DASHBOARD_USER=vguard
DASHBOARD_PASSWORD=
